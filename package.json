    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "nanoid": "^6.0.2",
    "next": "16.4.5",
    "playwright-core": "1.63.0",
