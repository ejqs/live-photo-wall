# Copy to .env.local for local development. Never commit real values.
# Postgres (Railway sets DATABASE_URL when you add a Postgres service)
DATABASE_URL=postgres://lpw:lpw@localhost:5432/lpw

# better-auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# Public URL of the app (used for auth, QR codes and links)
BETTER_AUTH_URL=http://localhost:3000

# S3-compatible bucket (Railway Bucket). Leave empty to store files on local disk (dev only).
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
# Local disk storage folder used when no bucket is configured
STORAGE_DIR=.data/storage

# Only this email may create the first (owner) account on the sign-in page. Set it before the first deploy.
OWNER_EMAIL=

# ---- worker service only (MP4 video export, retention cleanup) ----
# Address the worker uses to open the wall renderer. On Railway, the web service's private URL,
# e.g. http://${{web.RAILWAY_PRIVATE_DOMAIN}}:${{web.PORT}}. Defaults to BETTER_AUTH_URL.
RENDER_APP_URL=
# Optional overrides when Chromium or ffmpeg are not on the default paths
CHROMIUM_PATH=
FFMPEG_PATH=
